{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idpn.example.com/contracts/mfe-event.schema.json",
  "title": "IdpnEvent",
  "description": "Micro-frontend event contract, schema version 1.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "auth:login"
        },
        "user": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "avatarUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "id",
            "displayName"
          ],
          "additionalProperties": false
        },
        "loginContext": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "user",
        "loginContext"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "auth:logout"
        },
        "reason": {
          "type": "string",
          "enum": [
            "local",
            "global",
            "expired"
          ]
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "auth:error"
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "profile:updated"
        },
        "user": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "avatarUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "id",
            "displayName"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "user"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "locale:changed"
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "type": "string",
          "enum": [
            "rtl",
            "ltr"
          ]
        }
      },
      "required": [
        "type",
        "locale",
        "dir"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "context:changed"
        },
        "loginContext": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "loginContext"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "navigation:request"
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "to"
      ],
      "additionalProperties": false
    }
  ]
}
