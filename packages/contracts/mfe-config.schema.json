{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idpn.example.com/contracts/mfe-config.schema.json",
  "title": "IdpnMfeConfig",
  "description": "Micro-frontend configuration contract, schema version 1.",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "bff",
        "spa"
      ]
    },
    "apiBaseUrl": {
      "type": "string",
      "minLength": 1
    },
    "loginUrl": {
      "type": "string",
      "format": "uri"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "locales": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "supported": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dir": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "rtl",
              "ltr"
            ]
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "default",
        "supported",
        "dir"
      ],
      "additionalProperties": false
    },
    "loginContext": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "maxLength": 80
        },
        "foreground": {
          "type": "string",
          "maxLength": 80
        },
        "card": {
          "type": "string",
          "maxLength": 80
        },
        "primary": {
          "type": "string",
          "maxLength": 80
        },
        "primaryForeground": {
          "type": "string",
          "maxLength": 80
        },
        "secondary": {
          "type": "string",
          "maxLength": 80
        },
        "muted": {
          "type": "string",
          "maxLength": 80
        },
        "accent": {
          "type": "string",
          "maxLength": 80
        },
        "destructive": {
          "type": "string",
          "maxLength": 80
        },
        "border": {
          "type": "string",
          "maxLength": 80
        },
        "input": {
          "type": "string",
          "maxLength": 80
        },
        "ring": {
          "type": "string",
          "maxLength": 80
        },
        "radius": {
          "type": "string",
          "maxLength": 16
        },
        "fontFamily": {
          "type": "object",
          "properties": {
            "rtl": {
              "type": "string",
              "enum": [
                "vazirmatn",
                "inter",
                "system"
              ]
            },
            "ltr": {
              "type": "string",
              "enum": [
                "vazirmatn",
                "inter",
                "system"
              ]
            }
          },
          "additionalProperties": false
        },
        "dark": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string",
              "maxLength": 80
            },
            "foreground": {
              "type": "string",
              "maxLength": 80
            },
            "card": {
              "type": "string",
              "maxLength": 80
            },
            "primary": {
              "type": "string",
              "maxLength": 80
            },
            "primaryForeground": {
              "type": "string",
              "maxLength": 80
            },
            "secondary": {
              "type": "string",
              "maxLength": 80
            },
            "muted": {
              "type": "string",
              "maxLength": 80
            },
            "accent": {
              "type": "string",
              "maxLength": 80
            },
            "destructive": {
              "type": "string",
              "maxLength": 80
            },
            "border": {
              "type": "string",
              "maxLength": 80
            },
            "input": {
              "type": "string",
              "maxLength": 80
            },
            "ring": {
              "type": "string",
              "maxLength": 80
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "string",
      "enum": [
        "account",
        "user-management"
      ]
    },
    "basename": {
      "type": "string"
    },
    "features": {
      "type": "object",
      "properties": {
        "selfServiceRegistration": {
          "type": "boolean"
        },
        "userManagement": {
          "type": "boolean"
        },
        "mfa": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "clientId",
    "mode",
    "apiBaseUrl",
    "module"
  ],
  "additionalProperties": false
}
