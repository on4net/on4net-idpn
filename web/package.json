{
  "name": "@idpn/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite",
    "dev:host": "vite build --config vite.mfe.config.ts && vite --config vite.host.config.ts",
    "dev:e2e": "vite build --config vite.webcomponent.config.ts && vite",
    "ui:add": "pnpm dlx shadcn@4.22.0 add",
    "ui:init": "pnpm dlx shadcn@4.22.0 init",
    "build": "vite build",
    "build:host": "vite build --config vite.host.config.ts",
    "build:mfe": "vite build --config vite.mfe.config.ts",
    "build:wc": "vite build --config vite.webcomponent.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@idpn/config": "workspace:*",
    "@idpn/contracts": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@module-federation/vite": "1.23.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
