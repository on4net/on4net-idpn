{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@idpn/mfe-sdk": ["../packages/mfe-sdk/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "host/**/*.ts",
    "host-mf/**/*.ts",
    "host-mf/**/*.tsx",
    "vite*.config.ts"
  ]
}
