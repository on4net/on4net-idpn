# Shared staging variable contract — copy to `deploy/staging/.env.staging` and replace every
# placeholder. The real file is git-ignored; this example contains no working secret.
#
# Generate the cryptographic values with:
#   openssl rand -base64 32     # SESSION_SECRET, SOCIAL_SECRET_KEY, MFA_SECRET_KEY
# Keep the real values in the platform secret store (Vault/KMS), not in this file, whenever
# the deployment supports it.

# --- Backing services (used by compose.staging.yaml) ---------------------
STAGING_POSTGRES_USER=idpn_staging
STAGING_POSTGRES_PASSWORD=CHANGE_ME_staging_postgres_password
STAGING_POSTGRES_DB=idpn_staging
STAGING_POSTGRES_PORT=55441

STAGING_REDIS_PASSWORD=CHANGE_ME_staging_redis_password
STAGING_REDIS_PORT=56379

STAGING_MAIL_SMTP_PORT=1126
STAGING_MAIL_HTTP_PORT=8126

# --- API process environment (exported by the staging deployment) --------
# Keep the ports inside DATABASE_URL / REDIS_URL in sync with STAGING_POSTGRES_PORT and
# STAGING_REDIS_PORT; an env-file value is not interpolated by docker compose.
NODE_ENV=production
# Public staging host. Provider consoles register
# https://auth.staging.example.com/oauth2/social/<clientId>/<provider>/callback
APP_URL=https://auth.staging.example.com
HOSTED_UI_URL=https://auth.staging.example.com
ADMIN_URL=https://admin.staging.example.com
ADMIN_CLIENT_ID=admin-panel

DATABASE_URL=postgresql://idpn_staging:CHANGE_ME_staging_postgres_password@127.0.0.1:55441/idpn_staging
REDIS_URL=redis://:CHANGE_ME_staging_redis_password@127.0.0.1:56379/0

# Staging-only keys: a token, cookie or ciphertext issued here must not be valid in
# production, and vice versa.
SESSION_SECRET=CHANGE_ME_random_string_of_at_least_32_characters
SOCIAL_SECRET_KEY=CHANGE_ME_base64_of_32_bytes
MFA_SECRET_KEY=CHANGE_ME_base64_of_32_bytes
SIGNING_KEY_REF=CHANGE_ME_staging_signing_key_reference
KEY_ROTATION_INTERVAL_DAYS=0

SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_MAX_CONCURRENT=5
LOG_LEVEL=info

# Staging mail sink (Mailpit in compose.staging.yaml). Replace with the staging relay if
# invite delivery must be verified through a real mailbox.
SMTP_URL=smtp://127.0.0.1:1126
MAIL_FROM=no-reply@staging.example.com

# Public URL of the staging MFE bundle served by the pipeline.
MFE_PUBLIC_URL=https://cdn.staging.example.com/idpn-mfe
MFE_VERSION=0.1.0
MFE_ALLOWED_ORIGINS=https://app.staging.example.com
TRUSTED_PROXY_CIDRS=10.0.0.0/8
