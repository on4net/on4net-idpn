{
  "name": "@idpn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx --env-file-if-exists=../.env src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:rollback": "tsx scripts/db-rollback.ts",
    "db:seed": "prisma db seed",
    "seed:e2e": "tsx --env-file-if-exists=../.env scripts/seed-e2e.ts"
  },
  "dependencies": {
    "@idpn/config": "workspace:*",
    "@idpn/contracts": "workspace:^",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "fastify": "5.12.7",
    "jose": "^6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "18.0.8",
    "ioredis": "6.0.0",
    "msw": "3.0.3",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
