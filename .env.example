# on4net IDPN — example environment.
# Copy to `.env`, then replace every placeholder with a real value.
# `.env` is git-ignored: never commit real secrets or provider credentials.

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
# Interface the API binds to (127.0.0.1 keeps it off the LAN in development).
HOST=127.0.0.1
PORT=3000

# --- Public URLs ---------------------------------------------------------
# Issuer / auth base URL. Also exposed to the browser build as VITE_APP_URL.
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Public client id of the admin panel (the only client allowed the `idp.admin` scope).
ADMIN_CLIENT_ID=admin-panel
# Origin of the Hosted Auth UI when it is served by the web dev server instead of APP_URL.
# Empty means "same origin as APP_URL".
HOSTED_UI_URL=

# --- Data stores ---------------------------------------------------------
# Host ports published by `docker compose`; change them if a port is already in use,
# then update DATABASE_URL / REDIS_URL below to match.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025

# Credentials of the compose Postgres service (local development only; must match DATABASE_URL).
POSTGRES_USER=idpn
POSTGRES_PASSWORD=idpn
POSTGRES_DB=idpn

DATABASE_URL=postgresql://idpn:idpn@localhost:5432/idpn
REDIS_URL=redis://localhost:6379

# --- Secrets -------------------------------------------------------------
# Random value of at least 32 characters: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Reference to the signing key (Vault/KMS URI); leave empty to use a local key in development.
SIGNING_KEY_REF=
# Automatic signing-key rotation: days between rotations (90 per docs/security.md T10).
# Set to 0 to disable scheduled rotation and rotate only through POST /api/v1/keys/rotate.
KEY_ROTATION_INTERVAL_DAYS=90
# How long a retired key stays in JWKS (seconds). Must cover the longest access-token TTL.
KEY_RETIRED_RETENTION_SECONDS=3600
# In-process signing-key/JWKS cache TTL (seconds); 0 disables the cache.
KEY_CACHE_TTL_SECONDS=30

# --- IdP session ---------------------------------------------------------
# Sliding idle timeout and absolute lifetime, in seconds.
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
# Maximum concurrent sessions per user; the oldest sessions beyond the limit are revoked.
# Set to 0 to disable the limit.
SESSION_MAX_CONCURRENT=5

# --- Password hashing (Argon2id) ----------------------------------------# m=64MiB, t=3, p=1 by default (docs/security.md 3.1). Benchmark before raising.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Optional server-side pepper (>= 32 chars) kept in KMS/Vault; leave empty in development.
PASSWORD_PEPPER=

# --- Micro-frontend ------------------------------------------------------
MFE_PUBLIC_URL=http://localhost:3002/idpn-mfe
# Version directory of the published MFE bundle.
MFE_VERSION=0.1.0
# Comma separated list of host origins allowed to mount the MFE.
MFE_ALLOWED_ORIGINS=http://localhost:4000

# --- Integrations --------------------------------------------------------
SOCIAL_CALLBACK_BASE_URL=http://localhost:3000
# Key-encryption key for per-client social provider secrets: base64 of exactly 32 bytes
# (`openssl rand -base64 32`). Keep the real key in KMS/Vault in production; the API fails
# closed when it is missing there. Leave empty in development to disable credential writes.
SOCIAL_SECRET_KEY=
# Optional dedicated key-encryption key for TOTP secrets (base64 of exactly 32 bytes). When
# empty, SOCIAL_SECRET_KEY is used. Production fails closed without one of the two; leave
# both empty in development to disable MFA enrollment.
MFA_SECRET_KEY=
# Mailhog in local development (SMTP on 1025).
SMTP_URL=smtp://localhost:1025
# Envelope sender for invite, email verification and password reset messages.
MAIL_FROM=no-reply@on4net.dev

# --- Operations ----------------------------------------------------------
# Comma separated CIDRs of trusted reverse proxies.
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=info
